# Copiar fuera del repositorio, por ejemplo a /etc/ingesta-api/deploy.env.
# Este perfil conserva la instalación existente. No contiene credenciales SQL.
API_DIR=/var/www/ingesta-api
FRONT_DIR=/var/www/front-ddcp
SERVICE=ingesta-api.service
HTTPD=/opt/lampp/bin/httpd
HTTP_CONF=/opt/lampp/etc/httpd.conf
DDCP_CONF=/opt/lampp/etc/extra/ddcp.conf
CONFIG_FILE=/etc/ingesta-api/appsettings.Production.json
LOG_DIR=/var/log/ingesta-api
BACKUP_ROOT=/var/backups/ingesta-api
RUN_USER=opc
RUN_GROUP=opc
LISTEN_HOST=127.0.0.1
API_PORT=5002
DOMAIN=cni03.sspc.gob.mx
BASE_PATH=/ddcp/
API_EXECUTABLE=IngestaDeDatos.Api
DATABASE_NAME=DDCP
MODULO_CLAVE=DDCP
JWT_ISSUER=IngestaDeDatos.Api
JWT_AUDIENCE=IngestaDeDatos.Front
JWT_MINUTES=120
READY_ATTEMPTS=30
READY_INTERVAL_SECONDS=1
REQUEST_TIMEOUT_SECONDS=2
PROXY_TIMEOUT_SECONDS=600
MAX_UNPACK_BYTES=1073741824
SQLCMD_PATH=/opt/mssql-tools18/bin/sqlcmd
SQL_LOGIN_TIMEOUT_SECONDS=15
PUBLIC_ORIGIN=https://cni03.sspc.gob.mx
PUBLIC_TIMEOUT_SECONDS=15
MACHINE_ARCH=x86_64
APP_ENVIRONMENT=Production
